{
  "name": "CUSTOCARE",
  "private": false,
  "version": "2.13.15",
  "description": "Custocare",
  "author": "Custospark Company Ltd info@custospark.com",
  "type": "module",
  "main": "dist/desktop/main/main.js",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ]
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "node --max-old-space-size=8192 --stack-size=16384 ./node_modules/vite/bin/vite.js",
    "clean": "rimraf dist",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "react:build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "node --max-old-space-size=8192 --stack-size=16384 ./node_modules/typescript/bin/tsc --project src/tsconfig.json",
    "build:mac": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --arm64",
    "build:win": "npm run transpile:electron && npm run react:build && npx electron-builder --win --x64",
    "build:linux": "npm run transpile:electron && npm run react:build && npx electron-builder --linux --x64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux",
    "publish:mac": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --arm64 --publish always",
    "publish:win": "npm run transpile:electron && npm run react:build && npx electron-builder --win --x64 --publish always",
    "publish:linux": "npm run transpile:electron && npm run react:build && npx electron-builder --linux --x64 --publish always",
    "publish:all": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --win --linux --publish always"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.custospark.custocare",
    "productName": "Custocare",
    "directories": {
      "output": "dist/releases/",
      "buildResources": "assets"
    },
    "files": [
      "dist/desktop/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "dist/desktop/preload/preload.js",
        "to": "preload.js"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "target": "dmg",
      "icon": "public/assets/icon.nng"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/assets/icon.png"
    },
    "extraMetadata": {
      "main": "dist/desktop/main/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "Custospark",
      "repo": "custocare-web-desktop"
    }
  }
}
