{
  "name": "custocare-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/desktop/main/main.js",
    "compilerOptions": {
    "jsx": "react-jsx",      
    "types": ["vite/client", "node"] 
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "react:build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/tsconfig.json",
    "build:mac": "npm run transpile:electron && npm run react:build && npx electron-builder --mac --arm64",
    "build:win": "npm run transpile:electron && npm run react:build && npx electron-builder --win --x64",
    "build:linux": "npm run transpile:electron && npm run react:build && npx electron-builder --linux --x64",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.custospark.custocare-ai",
    "productName": "CustoCare AI",
    "directories": {
      "output": "dist/releases/",
      "buildResources": "assets"
    },
    "files": [
      "dist/desktop/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "dist/desktop/preload.js",
        "to": "preload.js"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/assets/icon.png"
    },
    "extraMetadata": {
      "main": "dist/desktop/main.js"
    },
    "publish": null
  }
}
