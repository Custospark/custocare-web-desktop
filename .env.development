VITE_APP_ENV=development
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_STORAGE_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT=30000
# PRODUCTION: Copy these from Hostinger's Laravel Reverb credentials
# Run `php artisan reverb:credentials` on the production server to get the values
# APP_KEY comes from REVERB_APP_KEY in backend .env
# HOST is the server IP/domain (e.g., vault.live)
# PORT is 443 for WSS (secure WebSocket) / 8080 for WS (local dev)
# SCHEME is https for production / http for local dev
VITE_REVERB_APP_KEY=local
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http